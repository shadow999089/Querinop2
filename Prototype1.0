}

class TelaQuedaDeBraco extends StatefulWidget {
  const TelaQuedaDeBraco({super.key});

  @override
  State<TelaQuedaDeBraco> createState() => _TelaQuedaDeBracoState();
}

class _TelaQuedaDeBracoState extends State<TelaQuedaDeBraco> {
  final TextEditingController _comentarioController = TextEditingController();
  // Lista temporária (depois você vai substituir pelos dados do banco)
  final List<String> _comentarios = [
    'Disputa equilibrada entre lógica e criatividade!',
  ];

  void _adicionarComentario() {
    if (_comentarioController.text.trim().isNotEmpty) {
      setState(() {
        _comentarios.add(_comentarioController.text.trim());
        _comentarioController.clear();
      });
    }
  }

  @override
  void dispose() {
    _comentarioController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('3. O Grande Duelo')),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20.0),
        child: Column(
          children: [
            Container(
              width: double.infinity,
              height: 190,
              decoration: BoxDecoration(
                color: const Color(0xFFE0E0E0),
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: const Color(0xFF9E9E9E), width: 2),
              ),
              child: const Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(Icons.smart_toy, size: 60, color: Color(0xFF424242)),
                      SizedBox(width: 16),
                      Icon(Icons.handshake, size: 45, color: Color(0xFF212121)),
                      SizedBox(width: 16),
                      Icon(
                        Icons.psychology,
                        size: 60,
                        color: Color(0xFF424242),
                      ),
                    ],
                  ),
                  SizedBox(height: 10),
                  Text(
                    '[Espaço para Imagem 3: Gemini vs Cérebro]',
                    style: TextStyle(color: Color(0xFF616161), fontSize: 12),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 16),
            const Text(
              'Gemini vs. Cérebro Humano',
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
                color: Color(0xFF212121),
              ),
            ),
            const SizedBox(height: 6),
            const Text(
              'Quem vence essa queda de braço? Deixe seu comentário abaixo:',
              textAlign: TextAlign.center,
              style: TextStyle(fontSize: 14, color: Color(0xFF616161)),
            ),
            const SizedBox(height: 20),

            Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _comentarioController,
                    decoration: const InputDecoration(
                      hintText: 'Escreva um comentário...',
                      filled: true,
                      fillColor: Colors.white,
                      border: OutlineInputBorder(),
                      contentPadding: EdgeInsets.symmetric(
                        horizontal: 12,
                        vertical: 10,
                      ),
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                ElevatedButton(
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF424242),
                    foregroundColor: Colors.white,
                    padding: const EdgeInsets.symmetric(
                      horizontal: 16,
                      vertical: 14,
                    ),
                  ),
                  onPressed: _adicionarComentario,
                  child: const Text('Enviar'),
                ),
              ],
            ),
            const SizedBox(height: 20),
            const Align(
              alignment: Alignment.centerLeft,
              child: Text(
                'Comentários:',
                style: TextStyle(
                  fontWeight: FontWeight.bold,
                  fontSize: 16,
                  color: Color(0xFF424242),
                ),
              ),
            ),
            const SizedBox(height: 8),

            ListView.builder(
              shrinkWrap: true,
              physics: const NeverScrollableScrollPhysics(),
              itemCount: _comentarios.length,
              itemBuilder: (context, index) {
                return Card(
                  color: Colors.white,
                  elevation: 1,
                  margin: const EdgeInsets.symmetric(vertical: 4),
                  child: ListTile(
                    leading: const Icon(
                      Icons.person_outline,
                      color: Color(0xFF616161),
                    ),
                    title: Text(
                      _comentarios[index],
                      style: const TextStyle(color: Color(0xFF212121)),
                    ),
                  ),
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}
